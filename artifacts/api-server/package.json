{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "dev:build": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "env DATABASE_URL=postgresql://test:test@127.0.0.1:1/elis_test node --import tsx --test src/services/*.test.ts",
    "seed:admin": "tsx src/seed-admin.ts",
    "migrate:sessions": "tsx src/migrate-sessions.ts",
    "migrate:last-sync-at": "tsx src/migrate-last-sync-at.ts",
    "migrate:offer-filters": "tsx src/migrate-offer-filters.ts",
    "migrate:offer-images": "tsx src/migrate-offer-images.ts",
    "migrate:offer-documents": "tsx src/migrate-offer-documents.ts",
    "migrate:stripe": "tsx src/migrate-stripe.ts",
    "migrate:booking-flow": "tsx src/migrate-booking-flow.ts",
    "seed:demo": "tsx src/seed-demo.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "basic-ftp": "^6.0.1",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.2.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "pino": "^9",
    "pino-http": "^10",
    "stripe": "^22.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.1.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.0",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
